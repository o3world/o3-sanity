    {
      "_type": "layoutSection",
      "_key": "why",
      "surface": "bone",
      "columns": 1,
      "eyebrow": "Why O3",
      "subheading": "Built to go end to end — on purpose.",
      "items": [
        {
          "_type": "richText",
          "_key": "why-body",
          "body": [
            {
              "_type": "block",
              "_key": "p0",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "p0s",
                  "text": "O3 was founded on a simple frustration: companies were forced to choose. Hire a strategy firm that hands you a deck and leaves, or an execution shop that builds exactly what's on the brief without ever asking if the brief is right. The gap between them is where good work goes to die — and where most of the cost hides.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p1",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "p1s",
                  "text": "We built O3 to close that gap. Strategy and execution under one roof, so the people who find the move are the people who build it. Twenty-one years later, that's still the whole idea — we've just gotten very good at it.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p2",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "p2s",
                  "text": "We're founder-led, and we've chosen quality over scale every year we've been in business: a deliberately senior team and a deliberately short client list, partners whose outcomes we're genuinely invested in. It's a slower way to grow. It's the only way to do work this deep.",
                  "marks": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_type": "disciplineGridSection",
      "_key": "disciplines",
      "surface": "white",
      "layout": "grid",
      "heading": "4 disciplines. One team.",
      "disciplines": [
        {
          "_type": "discipline",
          "_key": "d-strategy",
          "heading": "Strategy",
          "body": "Finds the real problem and the move worth making, before a line of code is written."
        },
        {
          "_type": "discipline",
          "_key": "d-design",
          "heading": "Design",
          "body": "Product-grade design that gives the move a form people actually want to use."
        },
        {
          "_type": "discipline",
          "_key": "d-engineering",
          "heading": "Engineering",
          "body": "Senior engineers who build it to last and to scale — the fix that ships, not a prototype to hand off."
        },
        {
          "_type": "discipline",
          "_key": "d-ai",
          "heading": "AI",
          "body": "Applied where it compounds the work, not where it decorates it — our O3XO practice, embedded where it earns its keep."
        }
