    "flexible_content": [
      {
        "acf_fc_layout": "multiple_columns",
        "acfe_flexible_toggle": "",
        "acfe_flexible_layout_title": "Solutions",
        "add_introduction": true,
        "introduction": {
          "": null,
          "kicker": "Services",
          "kicker_tag": "div",
          "title": "Consulting services that enlighten, inform + activate",
          "heading_level": "h2",
          "heading_tag": "div",
          "add_description": false,
          "description": ""
        },
        "introduction_link": "",
        "column": [
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9633\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/Assessicon-blue.png\" alt=\"blue circle with black assessment icon\" width=\"80\" height=\"80\" /></h4>\n<h4>Experience assessments</h4>\n<p class=\"small\">Misaligned journeys and siloed ways of working lead to inefficiencies and missed revenue opportunities. Through our AI-powered quantitative and qualitative experience assessment, we uncover gaps and opportunities, driving both efficiencies and business outcomes.</p>\n<h5>CASE STUDY</h5>\n<p><a class=\"underlined-link\" href=\"https://www.o3world.com/work/amerigas/\">Learn how we uncovered key customer experience insight that drives AmeriGas strategy to this day</a></p>\n"
              },
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4 style=\"margin-top: 100px;\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9633\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/Processicon-blue.png\" alt=\"blue circle with black process icon\" width=\"80\" height=\"80\" /></h4>\n<h4>UX + design process</h4>\n<p class=\"small\">Poorly designed digital experiences generally generally occur when UX teams struggle with efficient research and design processes. We deliver UX and UI audits that improve experiences, streamline processes, and empower teams with AI-driven insights and best practices.</p>\n<h5>perspective</h5>\n<p><a class=\"underlined-link\" href=\"https://www.o3world.com/perspectives/ai-you-bffs-in-delivering-exceptional-experiences/\">Discover how AI can elevate UX and design processes, driving efficiency and creating exceptional experiences</a></p>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9633\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/Consultingicon-blue.png\" alt=\"blue circle with black consulting icon\" width=\"80\" height=\"80\" /></h4>\n<h4>Innovation consulting</h4>\n<p class=\"small\">Innovation efforts often lack alignment with business goals, resulting in stalled progress and wasted resources. We work closely with organizational leaders to quickly assess, visualize, and validate concepts, ensuring that ideas are scalable, actionable, and impactful.</p>\n<h5>perspective</h5>\n<p><a class=\"underlined-link\" href=\"https://www.o3world.com/perspectives/innovation-workshops-o3\">Explore 6 tips for running a successful innovation workshop</a></p>\n"
              },
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4 style=\"margin-top: 100px;\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9633\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/Evalicon-blue.png\" alt=\"blue circle with black evaluation icon\" width=\"80\" height=\"80\" /></h4>\n<h4>Data + technology evaluation</h4>\n<p class=\"small\">Disconnected data and technology along with inefficient processes create fragmented digital experiences, hindering engagement and efficiency. We evaluate people, processes and technology to uncover gaps and streamline operations to deliver better digital solutions.</p>\n<h5>perspective</h5>\n<p><a class=\"underlined-link\" href=\"https://www.o3world.com/perspectives/navigating-generative-ai-black-box-transparency-control/\">Explore the need for clear understanding and control when implementing AI</a></p>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9633\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/Activationicon-blue.png\" alt=\"blue circle with black activation icon\" width=\"80\" height=\"80\" /></h4>\n<h4>Rapid activation</h4>\n<p class=\"small\">Insight without action leads to lost momentum and missed opportunities. We transform insights into actionable roadmaps and bring ideas to life through our POC and MVP process, rapidly developing concepts that deliver measurable outcomes.</p>\n<h5>CASE STUDY</h5>\n<p><a class=\"underlined-link\" href=\"https://www.o3world.com/work/rfp-automation/\">See how we saved this global technology firm 40% of time by automating RFP responses</a></p>\n"
              },
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4 style=\"margin-top: 100px;\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9633\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/Changeicon-blue-1.png\" alt=\"blue icon with black swirl symbol representing change\" width=\"80\" height=\"80\" /></h4>\n<h4>Change management</h4>\n<p class=\"small\">Without a plan to manage mindset and behavioral change, even the most well-designed projects fail to achieve lasting impact. We ensure successful project activation by fostering alignment, engagement, and sustainable adoption across teams.</p>\n<h5>perspective</h5>\n<p><a class=\"underlined-link\" href=\"https://www.o3world.com/perspectives/embracing-disruptive-thinking-enterprise-teams/\">Learn how disruptive thinking can empower enterprise teams to adapt and thrive in dynamic environments.</a></p>\n"
              }
            ]
          }
        ]
      },
