      {
        "acf_fc_layout": "multiple_columns",
        "acfe_flexible_toggle": "",
        "acfe_flexible_layout_title": "Why O3",
        "add_introduction": true,
        "introduction": {
          "": null,
          "kicker": "",
          "kicker_tag": "div",
          "title": "Why O3",
          "heading_level": "h2",
          "heading_tag": "div",
          "add_description": false,
          "description": "Retail Manager, Aramark"
        },
        "introduction_link": "",
        "column": [
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>Strategy + execution under one roof</h4>\n<p>We align stakeholders, define roadmaps, and deliver the work so strategy becomes shipped reality rather than a handoff document.</p>\n"
              },
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>Outcomes over outputs</h4>\n<p>We measure success in business terms: performance, engagement, efficiency, and growth, not just deliverables completed.</p>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>Senior-led teams, intentionally small</h4>\n<p>O3 is founder-led and built for quality over scale. Engagements are led by experienced practitioners who stay close from direction through delivery.</p>\n"
              },
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>What we’re not</h4>\n<p>We&#8217;re not a strategy-only consultancy, a production-only agency, or a staff augmentation firm. We bring the thinking and the building together, measured by your business performance, not our output volume.</p>\n"
              }
            ]
          }
        ]
      },
