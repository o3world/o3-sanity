        "introduction_link": "",
        "column": [
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<div class=\"relative w-full group\">\n<div class=\"w-full bg-gray-100 mb-[30px] aspect-1\">\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-medium wp-image-9614\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/1682head-640x640.png\" alt=\"photo of a pile of badges from the 1682 conference\" width=\"640\" height=\"640\" srcset=\"http://www.o3world.com/wp-content/uploads/2025/02/1682head-640x640.png 640w, http://www.o3world.com/wp-content/uploads/2025/02/1682head-150x150.png 150w, http://www.o3world.com/wp-content/uploads/2025/02/1682head-768x768.png 768w, http://www.o3world.com/wp-content/uploads/2025/02/1682head-48x48.png 48w, http://www.o3world.com/wp-content/uploads/2025/02/1682head.png 901w\" sizes=\"auto, (max-width: 640px) 100vw, 640px\" /></p>\n</div>\n<h3 class=\"mb-3 text-black type-kicker\">1682</h3>\n<h4 style=\"margin-top: 12px;\">The business of innovation conference + event series</h4>\n<p><span class=\"text-black hover:text-black focus:text-black\">Our annual conference, 1682 explores the ever-changing landscape of innovation programs, with a particular focus on how people, profits, process, and technology.</span></p>\n<p><a href=\"https://www.o3world.com/1682-conference-ai-innovation/\">Learn more about 1682</a></p>\n</div>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<div class=\"relative w-full group\">\n<div class=\"w-full bg-gray-100 mb-[30px] aspect-1\"><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-medium wp-image-9616\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/Ventureshead-640x640.png\" alt=\"photo of ventures awards\" width=\"640\" height=\"640\" srcset=\"http://www.o3world.com/wp-content/uploads/2025/02/Ventureshead-640x640.png 640w, http://www.o3world.com/wp-content/uploads/2025/02/Ventureshead-150x150.png 150w, http://www.o3world.com/wp-content/uploads/2025/02/Ventureshead-768x768.png 768w, http://www.o3world.com/wp-content/uploads/2025/02/Ventureshead-48x48.png 48w, http://www.o3world.com/wp-content/uploads/2025/02/Ventureshead.png 901w\" sizes=\"auto, (max-width: 640px) 100vw, 640px\" /></div>\n<h3 class=\"mb-3 text-black type-kicker\">Ventures</h3>\n<h4 style=\"margin-top: 12px;\">Investing in exceptional people, products + experiences</h4>\n<p><span class=\"text-black hover:text-black focus:text-black\">We have invest time, expertise, and resources into organizations that share our values and understand the opportunities to create better experiences.</span></p>\n</div>\n<p><a href=\"https://www.o3world.com/ventures/\">Learn about Ventures</a></p>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<div class=\"relative w-full group\">\n<div class=\"w-full bg-gray-100 mb-[30px] aspect-1\">\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-medium wp-image-9612\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2025/02/communityhead-1-640x640.png\" alt=\"team photo of O3 employees with a red semi circle\" width=\"640\" height=\"640\" srcset=\"http://www.o3world.com/wp-content/uploads/2025/02/communityhead-1-640x640.png 640w, http://www.o3world.com/wp-content/uploads/2025/02/communityhead-1-150x150.png 150w, http://www.o3world.com/wp-content/uploads/2025/02/communityhead-1-768x768.png 768w, http://www.o3world.com/wp-content/uploads/2025/02/communityhead-1-48x48.png 48w, http://www.o3world.com/wp-content/uploads/2025/02/communityhead-1.png 901w\" sizes=\"auto, (max-width: 640px) 100vw, 640px\" /></p>\n</div>\n<h3 class=\"mb-3 text-black type-kicker\">Community</h3>\n<h4 style=\"margin-top: 12px;\">Our commitment to making the world a better place</h4>\n<p><span class=\"text-black hover:text-black focus:text-black\">We focus on values and culture alignment to create better experiences for people within the organizations we support and in the wider world around us.</span></p>\n<p><a href=\"https://www.o3world.com/community-engagement/\">Commit to community</a></p>\n</div>\n"
              }
            ]
          }
