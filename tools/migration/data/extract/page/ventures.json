        "column": [
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<div class=\"relative w-full group\">\n<a href=\"https://live-o3-world.pantheonsite.io/work/scarlet-ai-hyper-personalizing-creative-gig-economy/\" class=\"hover:text-brand-red focus:text-brand-red\"></p>\n<div class=\"w-full bg-gray-100 mb-[30px] aspect-1\">\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-8770 size-full\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2024/02/o3-rec-featured-cs-image.jpg\" alt=\"Scarlet AI\" width=\"546\" height=\"546\" srcset=\"http://www.o3world.com/wp-content/uploads/2024/02/o3-rec-featured-cs-image.jpg 546w, http://www.o3world.com/wp-content/uploads/2024/02/o3-rec-featured-cs-image-150x150.jpg 150w, http://www.o3world.com/wp-content/uploads/2024/02/o3-rec-featured-cs-image-48x48.jpg 48w\" sizes=\"auto, (max-width: 546px) 100vw, 546px\" /></p>\n</div>\n<h3 class=\"mb-3 text-black type-kicker\">REC PHILLY</h3>\n<h4 style=\"margin-top: 12px;\">Empowering creative entrepreneurs</h4>\n<p><span class=\"text-black hover:text-black focus:text-black\">A “WeWork for artists”, REC Philly empowers creative entrepreneurs by providing space, equipment, community and expertise to support their growth. In order to expand from its humble, North Philly space into a 10,000 square foot creative complex, REC Philly required both a financial investor as well as a strategic development partner.</span><br />\n</a>\n</div>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<div class=\"relative w-full group\">\n<a href=\"https://www.o3world.com/perspectives/sahay-ai-triumphs-1682-venture-awards\"  class=\"hover:text-brand-red focus:text-brand-red\"></p>\n<div class=\"w-full bg-gray-100 mb-[30px] aspect-1\">\n<img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9302 size-medium\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2024/10/1682-website-social-imagery-6-640x640.png\" alt=\"Venture Awards at 1682 - Sahay AI\" width=\"640\" height=\"640\" srcset=\"http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-640x640.png 640w, http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-150x150.png 150w, http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-768x768.png 768w, http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-1024x1024.png 1024w, http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-1536x1536.png 1536w, http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-2048x2048.png 2048w, http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-48x48.png 48w, http://www.o3world.com/wp-content/uploads/2024/10/1682-website-social-imagery-6-1280x1280.png 1280w\" sizes=\"auto, (max-width: 640px) 100vw, 640px\" /></p>\n</div>\n<h3 class=\"mb-3 text-black type-kicker\">Sahay AI</h3>\n<h4 style=\"margin-top: 12px;\">Keeping AI on Track</h4>\n<p><span class=\"text-black hover:text-black focus:text-black\">At O3, we don’t just celebrate AI-driven startups—we help them build momentum. As the winner of the 1682 Venture Awards, Sahay AI is revolutionizing railway safety with machine learning and automation. Now, through our venture consulting practice, we’re working alongside their team to refine strategy, enhance product-market fit, and accelerate their journey.</span><br />\n</a>\n</div>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<div class=\"relative w-full group\">\n<a href=\"https://www.o3world.com/perspectives/the-o3-venture-awards-at-1682-a-chance-to-pitch-win-and-promote-your-ai-startup\" class=\"hover:text-brand-red focus:text-brand-red\"></p>\n<div class=\"w-full bg-gray-100 mb-[30px] aspect-1\">\n<img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-9785 size-medium\" src=\"https://live-o3-world.pantheonsite.io/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-640x640.webp\" alt=\"The O3 Venture Awards\" width=\"640\" height=\"640\" srcset=\"http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-640x640.webp 640w, http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-150x150.webp 150w, http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-768x768.webp 768w, http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-1024x1024.webp 1024w, http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-1536x1536.webp 1536w, http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-2048x2048.webp 2048w, http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-48x48.webp 48w, http://www.o3world.com/wp-content/uploads/2019/08/O3-website-imagery_-Perspectives-60-1280x1280.webp 1280w\" sizes=\"auto, (max-width: 640px) 100vw, 640px\" />\n</div>\n<h3 class=\"mb-3 text-black type-kicker\">1682</h3>\n<h4 style=\"margin-top: 12px;\">Fueling the future: venture awards</h4>\n<p><span class=\"text-black hover:text-black focus:text-black\">Great ideas deserve a platform. The O3 Venture Awards at 1682 give AI-driven startups the chance to pitch their innovations, gain exposure, and connect with industry leaders. More than just a competition, it&#8217;s an opportunity to accelerate growth, refine strategy, and take bold ideas to the next level. Keep an eye out for this year&#8217;s 1682 conference.</span><br />\n</a>\n</div>\n"
              }
            ]
          }
        ]
