        "add_introduction": true,
        "introduction": {
          "": null,
          "kicker": "WHAT WE OFFER",
          "kicker_tag": "h2",
          "title": "Bring your best while living your best life",
          "heading_level": "h2",
          "heading_tag": "p",
          "add_description": false,
          "description": ""
        },
        "introduction_link": "",
        "column": [
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>Professional development</h4>\n<p class=\"lead\">Attend conferences, enjoy educational opportunities, emphasize your own growth + development, and get guidance on what&#8217;s next for your career at O3.</p>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>Work perks</h4>\n<p class=\"lead\">Enjoy the benefits of premium health insurance (medical, dental, and vision), a 401k match, flexible schedule, hybrid workplace, paid family leave, volunteer time off, and charitable donation matches.</p>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>Mentorship</h4>\n<p class=\"lead\">Take advantage of opportunities to teach other teammates new skills and accelerate our collective growth.</p>\n"
              }
            ]
          },
          {
            "content": [
              {
                "acf_fc_layout": "text",
                "text_editor": "<h4>Community involvement</h4>\n<p class=\"lead\">Create meaningful impact with us. We hold ourselves accountable for changing the lives of those we serve for the better.</p>\n"
              }
            ]
          }
        ]
      },
