                "kicker": "LIFE AT O3",
                "kicker_tag": "h2",
                "title": "We're in good company.",
                "heading_level": "h2",
                "heading_tag": "p",
                "add_description": true,
                "description": "Our Philly headquarters is in the heart of Fishtown on Frankford Ave, with the incredible coffee roaster La Colombe next door to keep us energized."
              }
