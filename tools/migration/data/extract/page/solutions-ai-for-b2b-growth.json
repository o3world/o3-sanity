          {
            "acf_fc_layout": "title",
            "kicker": "Why O3",
            "kicker_tag": "div",
            "title": "Proven AI use cases, established processes + real-world results",
            "heading_level": "h2",
            "heading_tag": "div",
            "add_description": true,
            "description": "With years of AI experience, we’ve delivered proven use cases that drive measurable outcomes. Our POC process allows us to mitigate risk and deliver ROI."
