    }
  ],
  "publishedAt": "2022-08-15T22:05:35Z",
  "featuredImage": {
    "_type": "figure",
    "image": {
      "_type": "image",
      "_wpSrc": "https://www.o3world.com/wp-content/uploads/2022/08/accessibility-power-hour.jpg"
    },
    "alt": "Why Accessibility shouldn't be an afterthought"
  },
  "body": [
    {
      "_key": "k0002",
      "children": [
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "What is digital accessibility?",
          "_key": "k0003"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0004",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Digital accessibility ensures that tools, websites, and technologies are designed and implemented so those with disabilities can use them effectively. It focuses on making the web and digital products easier to use for everyone, regardless of their ability.",
          "_key": "k0005"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0006",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Some of the common types of disabilities that people may experience include:",
          "_key": "k0007"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0008",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Vision",
          "_key": "k0009"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0010",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Speech",
          "_key": "k0011"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0012",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Hearing",
          "_key": "k0013"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0014",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Cognitive",
          "_key": "k0015"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0016",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Motor control",
          "_key": "k0017"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0018",
      "children": [
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "How could an investment in digital accessibility positively impact a brand?",
          "_key": "k0019"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0020",
      "children": [
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Improved overall customer experience (CX)",
          "_key": "k0021"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0022",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Taking accessibility into account from the start of a project results in an experience that not only provides equal accommodation for individuals with disabilities but also produces a better experience for everyone.",
          "_key": "k0023"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0024",
      "children": [
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Overlap in web best practices",
          "_key": "k0025"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0026",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Accessibility overlaps with a multitude of best practices such as mobile-optimized design, performance, usability, and SEO. Generally, websites that take accessibility into account also have reduced maintenance costs.",
          "_key": "k0027"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0028",
      "children": [
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Enhanced brand reputation",
          "_key": "k0029"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0030",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Adopting a comprehensive accessibility practice can serve to enhance brand image and reputation, as well as increase sales and customer loyalty. In addition, hiring and employee retention can be improved through internal diversity and inclusion efforts.",
          "_key": "k0031"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0032",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Extended market reach and increased return on investment (ROI)",
          "_key": "k0033"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0034",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Equal digital access is no longer a novelty but a critical tool of modern life. From a business perspective, the spending power of individuals with disabilities in the U.S. alone is more than $300 billion.",
          "_key": "k0035"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0036",
      "children": [
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Reduced legal risk",
          "_key": "k0037"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0038",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "There are unnecessary legal risks involved when you don’t support accessibility. The cost and risk of inaction can be huge as well as damaging to your brand reputation.",
          "_key": "k0039"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0040",
      "children": [
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "How can O3 help?",
          "_key": "k0041"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0042",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "O3’s expert accessibility team has created a ",
          "_key": "k0043"
        },
        {
          "_type": "span",
          "marks": [
            "k0000"
          ],
          "text": "downloadable e-book, “What Brands Need to Know About Digital Accessibility”",
          "_key": "k0044"
        },
        {
          "_type": "span",
          "marks": [],
          "text": ", to help brands get a handle on important guidelines and laws. We are committed to creating great experiences for everyone – ensuring that all websites and products that we build consider everyone.",
          "_key": "k0045"
        }
      ],
      "markDefs": [
        {
          "_key": "k0000",
          "_type": "link",
          "href": "https://www.o3world.com/news/what-brands-need-to-know-about-digital-accessibility/"
        }
      ],
      "_type": "block",
      "style": "normal"
    },
    {
