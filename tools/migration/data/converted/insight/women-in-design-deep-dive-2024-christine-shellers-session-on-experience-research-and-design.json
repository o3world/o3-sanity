      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0020",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "A comprehensive understanding of popular research methodologies used in design.",
          "_key": "k0021"
