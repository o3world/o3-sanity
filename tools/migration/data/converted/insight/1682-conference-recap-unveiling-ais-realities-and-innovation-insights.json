        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0114",
      "children": [
        {
          "_type": "span",
          "marks": [
            "k0013"
          ],
          "text": "Sushma Rajagopalan",
          "_key": "k0115"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " of Rittenhouse Ventures moderated a discussion with ",
          "_key": "k0116"
        },
        {
          "_type": "span",
          "marks": [
            "k0014"
          ],
          "text": "Russ Kliman",
          "_key": "k0117"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " (Future Crafted), ",
          "_key": "k0118"
        },
        {
          "_type": "span",
          "marks": [
            "k0015"
          ],
          "text": "Emily Foote",
          "_key": "k0119"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " (Osage Venture Partners), and ",
          "_key": "k0120"
        },
        {
          "_type": "span",
          "marks": [
            "k0016"
          ],
          "text": "Omar Mencin",
          "_key": "k0121"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " (Ben Franklin Technology Partners). The panelists advised focusing on investments that have measurable ROI. Kliman emphasized the importance of proprietary data, while Foote highlighted the need for clarity in problem selection to ensure AI’s value is fully realized.",
          "_key": "k0122"
        }
      ],
