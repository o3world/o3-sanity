          "_key": "k0130"
        },
        {
          "_type": "span",
          "marks": [
            "k0019"
          ],
          "text": "Rick Nucci",
          "_key": "k0131"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " (Guru), and ",
          "_key": "k0132"
        },
        {
          "_type": "span",
          "marks": [
