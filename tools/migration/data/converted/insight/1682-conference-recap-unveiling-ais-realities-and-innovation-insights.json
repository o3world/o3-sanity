        {
          "_type": "span",
          "marks": [],
          "text": "Leveraging AI for Meaningful Digital Experiences: ",
          "_key": "k0126"
        },
        {
          "_type": "span",
          "marks": [
            "k0017"
          ],
          "text": "Christine Sheller",
          "_key": "k0127"
        },
        {
          "_type": "span",
