    {
      "_key": "k0000",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Join us on Wednesday, ",
          "_key": "k0001"
        },
        {
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "October 13th at 5:00 pm ET",
          "_key": "k0002"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " for No Mouse Day to take part in a unique and engaging workshop coordinated by the web accessibility experts at O3.",
          "_key": "k0003"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0004",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Why no mouse?",
          "_key": "k0005"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0006",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Easy, intuitive website navigation is a fundamental component of good digital design and successful customer experience. But most online desktop experiences are optimized for mouse-based navigation, ignoring the needs of disabled individuals who use a keyboard to get around the internet.",
          "_key": "k0007"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0008",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "What better way to understand the challenges and inaccessibility of mouse-first design than to experience it firsthand?",
          "_key": "k0009"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0010",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Join us for an interactive workshop in which our accessibility experts will:",
          "_key": "k0011"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0012",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Discuss the common pitfalls of inaccessible web navigation",
          "_key": "k0013"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0014",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Offer a framework for building inclusive digital experiences",
          "_key": "k0015"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0016",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Facilitate a collaborative no-mouse exercise for participants",
          "_key": "k0017"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0018",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Who should attend?",
          "_key": "k0019"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0020",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "This event isn’t just for designers and developers–anyone who wishes to gain a deeper understanding of accessible web design is welcome to join.",
          "_key": "k0021"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
