      "_key": "k0001",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "O3 Moods is an application that transforms the atmosphere of a room by altering the lighting to match the personality of whoever is in the room. It does this by harnessing the power of Twitter and IBM’s Watson API, specifically its Personality Insights feature.",
          "_key": "k0002"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0003",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "O3 Moods takes tweets from a given account, analyzes the personality of that user, translates that user’s personality to a color, and then changes the colors of the lights in the room to that color.",
          "_key": "k0004"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
