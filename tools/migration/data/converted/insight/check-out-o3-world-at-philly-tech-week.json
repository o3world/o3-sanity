        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0008",
      "children": [
        {
          "_type": "span",
          "marks": [
            "k0000"
          ],
          "text": "Register",
          "_key": "k0009"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " to join the discussion!",
          "_key": "k0010"
        }
      ],
      "markDefs": [
        {
