        {
          "_type": "span",
          "marks": [],
          "text": "We are thrilled to announce that O3’s ",
          "_key": "k0006"
        },
        {
          "_type": "span",
          "marks": [
            "k0000"
          ],
          "text": "2023 Innovation Day",
          "_key": "k0007"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " is back and better than ever, now aligned with ",
          "_key": "k0008"
        },
        {
          "_type": "span",
          "marks": [
            "k0001"
          ],
          "text": "Philly Tech Week",
          "_key": "k0009"
        },
        {
          "_type": "span",
          "marks": [],
          "text": ". This event offers a unique opportunity to learn and grow in the innovation space.",
          "_key": "k0010"
        }
      ],
      "markDefs": [
        {
          "_key": "k0000",
          "_type": "link",
