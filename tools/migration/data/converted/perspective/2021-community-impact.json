    {
      "_key": "k0064",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "It’s important to note that we also established new programs to better support our team’s philanthropic efforts:",
          "_key": "k0065"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0066",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Extended our employee match program to $5K in 2020.",
          "_key": "k0067"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0068",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Created an employee Volunteer Time Off policy to encourage our employees to give back to the community through volunteering with organizations that matter to them",
          "_key": "k0069"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0070",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Enabled our team to use Bonusly points for charitable donations any day, all year.",
          "_key": "k0071"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0072",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "And when times were tough during the pandemic we supported these local businesses by purchasing over $2,500 worth of gift cards:",
          "_key": "k0073"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
