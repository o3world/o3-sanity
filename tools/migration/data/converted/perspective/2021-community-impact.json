      "style": "h2"
    },
    {
      "_key": "k0042",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "In an effort to excite young Philadelphians about careers in tech and attract the next generation of leaders we:",
          "_key": "k0043"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0044",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Led a ",
          "_key": "k0045"
        },
        {
          "_type": "span",
          "marks": [
            "k0001"
          ],
          "text": "mentorship program",
          "_key": "k0046"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " with ",
          "_key": "k0047"
        },
        {
          "_type": "span",
          "marks": [
            "k0002"
          ],
          "text": "Roxborough High School",
          "_key": "k0048"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " to expose students to concepts ranging from information organization and user experience design to basic web development. This reinforces the skills students learn by building websites using HTML and CSS.",
          "_key": "k0049"
        }
      ],
      "markDefs": [
        {
          "_key": "k0001",
