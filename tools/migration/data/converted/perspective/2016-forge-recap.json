    {
      "_key": "k0022",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "If you weren’t able to make it to this year’s sold-out event, don’t worry, we got you covered. This year, we’ve worked with our sponsor Hightail to create a space where a few of the speakers generously shared their presentation slides. This provided access to comment and review each Forge Conference speaker’s story. You can access their presentations at the ",
          "_key": "k0023"
        },
        {
          "_type": "span",
          "marks": [
            "k0005"
          ],
          "text": "2016 Forge Conference Hightail",
          "_key": "k0024"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " page.",
          "_key": "k0025"
        }
      ],
      "markDefs": [
        {
          "_key": "k0005",
