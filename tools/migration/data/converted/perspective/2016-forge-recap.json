          "href": "https://spaces.hightail.com/space/xJIX5"
        }
      ],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0026",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Did you know that #ForgeConf was the #3 trending topic of the day? Don’t forget to check out the ",
          "_key": "k0027"
        },
        {
          "_type": "span",
          "marks": [
            "k0006"
