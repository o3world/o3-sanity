  "publishedAt": "2019-09-26T21:33:14Z",
  "featuredImage": {
    "_type": "figure",
    "image": {
      "_type": "image",
      "_wpSrc": "https://www.o3world.com/wp-content/uploads/2023/01/O3-website-imagery_-Insights-3.jpg"
