      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "O3 is thrilled to announce that ",
          "_key": "k0010"
        },
        {
          "_type": "span",
          "marks": [
            "k0000"
          ],
          "text": "Christine Sheller",
          "_key": "k0011"
        },
        {
          "_type": "span",
          "marks": [],
          "text": ", our Senior Vice President of Experience Research and Design, will be a keynote speaker at the ",
          "_key": "k0012"
        },
        {
          "_type": "span",
          "marks": [
            "k0001"
          ],
          "text": "BeMore Festival 2023",
          "_key": "k0013"
        },
        {
          "_type": "span",
          "marks": [],
          "text": ". This 24-hour superconference, set to take place on September 20–21, brings together professionals and visionaries from over 25 countries.",
          "_key": "k0014"
        }
      ],
      "markDefs": [
        {
          "_key": "k0000",
