    {
      "_key": "k0015",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "This immersive event will feature live keynotes, networking opportunities, and dynamic panel discussions. With more than 100 power speakers, BeMore Festival is set to be a global gathering of minds in the fields of design, AI, product development, and career advancement.",
          "_key": "k0016"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
