        {
          "_type": "span",
          "marks": [],
          "text": "\n",
          "_key": "k0019"
        },
        {
          "_type": "span",
          "marks": [
            "k0002"
          ],
          "text": "CHECK OUT THE EVENT",
          "_key": "k0020"
        }
      ],
      "markDefs": [
