    {
      "_key": "k0092",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Sam Roth, a DPM, presented on mnemonics at ",
          "_key": "k0093"
        },
        {
          "_type": "span",
          "marks": [
            "k0018"
          ],
          "text": "BarCamp",
          "_key": "k0094"
        },
        {
          "_type": "span",
          "marks": [],
          "text": ". He shared how he powers through his to-do list.",
          "_key": "k0095"
