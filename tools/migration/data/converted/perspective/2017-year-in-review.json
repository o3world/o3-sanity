        {
          "_type": "span",
          "marks": [],
          "text": "Dan Singer, UX strategist, focused in on the “default and other in edge cases” at World Usability Day 2017. ",
          "_key": "k0100"
        },
        {
          "_type": "span",
          "marks": [
            "k0020"
          ],
          "text": "Check out the slides",
          "_key": "k0101"
