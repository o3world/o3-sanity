      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Things We’ve Done (as a team)",
          "_key": "k0104"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0105",
      "children": [
        {
          "_type": "span",
          "marks": [
            "k0021"
          ],
          "text": "Agency Field Day",
          "_key": "k0106"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " is always a big highlight of our year. This year five agencies in the Philadelphia-area came together for a ",
          "_key": "k0107"
        },
        {
          "_type": "span",
          "marks": [
            "em"
          ],
          "text": "little",
          "_key": "k0108"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " friendly competition.",
          "_key": "k0109"
        }
      ],
      "markDefs": [
        {
          "_key": "k0021",
          "_type": "link",
          "href": "/perspectives/recapping-2017-agency-field-day/"
        }
      ],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0110",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "We’re proud to partner with Greensgrow Farms to make our community more sustainable. This year they saw a lot of us, particularly at the ",
          "_key": "k0111"
        },
        {
          "_type": "span",
          "marks": [
            "k0022"
          ],
          "text": "Greensgrow Fall Festival",
          "_key": "k0112"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " where 12 members of our staff helped out.",
          "_key": "k0113"
        }
      ],
      "markDefs": [
        {
          "_key": "k0022",
          "_type": "link",
          "href": "/perspectives/o3-world-volunteers-at-greensgrow-farms-fall-festival/"
        }
      ],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0114",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "We hosted ",
          "_key": "k0115"
        },
        {
          "_type": "span",
          "marks": [
            "k0023"
          ],
          "text": "Innovation Day",
          "_key": "k0116"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " as a part of Philly Tech week 2017. The event consisted of different talks that generated awareness around innovation and emerging technologies. And our favorite sponsor/coffee roaster/neighbor, La Colombe coffee.",
          "_key": "k0117"
        }
      ],
      "markDefs": [
        {
          "_key": "k0023",
          "_type": "link",
