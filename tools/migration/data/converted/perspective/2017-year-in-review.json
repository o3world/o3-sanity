        {
          "_type": "span",
          "marks": [],
          "text": "Earlier this year, our development team volunteered at ",
          "_key": "k0119"
        },
        {
          "_type": "span",
          "marks": [
            "k0024"
          ],
          "text": "Code by: Kids",
          "_key": "k0120"
        },
