    {
      "_key": "k0009",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "On Sunday, January 21, 2024, O3’s CEO, ",
          "_key": "k0010"
        },
        {
          "_type": "span",
          "marks": [
            "k0000"
          ],
          "text": "Michael Soileau",
          "_key": "k0011"
        },
        {
          "_type": "span",
          "marks": [],
          "text": ", is participating in a fireside chat titled “",
          "_key": "k0012"
        },
        {
          "_type": "span",
          "marks": [
            "k0001"
          ],
          "text": "The Future of Healthcare",
          "_key": "k0013"
        },
        {
          "_type": "span",
          "marks": [],
          "text": "” as part of the ",
          "_key": "k0014"
        },
        {
          "_type": "span",
          "marks": [
            "k0002"
          ],
          "text": "World Logic Day",
          "_key": "k0015"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " celebration. The panel conversation will delve into discussions on advocating for and creating improved healthcare solutions through innovation. The esteemed panel includes ",
          "_key": "k0016"
        },
        {
          "_type": "span",
          "marks": [
            "k0003"
          ],
          "text": "Rachel Mallernee",
          "_key": "k0017"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " from Texas Children’s Hospital, ",
          "_key": "k0018"
        },
        {
          "_type": "span",
          "marks": [
            "k0004"
          ],
          "text": "Neil Devani",
          "_key": "k0019"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " of Necessary VC, and ",
          "_key": "k0020"
        },
        {
          "_type": "span",
          "marks": [
            "k0005"
          ],
          "text": "Alex Trevino",
          "_key": "k0021"
        },
        {
          "_type": "span",
