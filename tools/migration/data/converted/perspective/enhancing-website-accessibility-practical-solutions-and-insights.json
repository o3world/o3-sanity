      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Purpose",
          "_key": "k0026"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0027",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Participants will gain essential skills to recognize and tackle accessibility issues within their platforms, ensuring a more inclusive user experience. This workshop offers practical knowledge, strategies, and techniques to enhance your website’s accessibility.",
          "_key": "k0028"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal"
    },
    {
      "_key": "k0029",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Key Takeaways",
          "_key": "k0030"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "h3"
    },
    {
      "_key": "k0031",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Identify common accessibility problems: Learn to spot the most frequent accessibility issues that users face.",
          "_key": "k0032"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0033",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Implement practical solutions: Discover ways to make your website easier to navigate for everyone.",
          "_key": "k0034"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0035",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Enhance engagement through inclusive design: Understand how inclusivity can boost engagement and reach a wider audience.",
          "_key": "k0036"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
    },
    {
      "_key": "k0037",
      "children": [
        {
          "_type": "span",
          "marks": [],
          "text": "Leverage tools and resources: Get familiar with the tools and resources that can help you improve your site’s accessibility.",
          "_key": "k0038"
        }
      ],
      "markDefs": [],
      "_type": "block",
      "style": "normal",
      "level": 1,
      "listItem": "bullet"
