            "k0001"
          ],
          "text": "Barbara Pender",
          "_key": "k0025"
        },
        {
          "_type": "span",
          "marks": [],
          "text": " is the Global GEN AI Deputy & Delivery Lead at ",
          "_key": "k0026"
        },
        {
          "_type": "span",
          "marks": [
            "k0002"
          ],
          "text": "Accenture",
          "_key": "k0027"
        },
        {
          "_type": "span",
          "marks": [],
          "text": ". Pender brings a wealth of experience and expertise in navigating the intricate landscape of artificial intelligence. Her insights shed light on practical applications of AI, emphasizing its transformative potential.",
          "_key": "k0028"
        }
      ],
      "markDefs": [
        {
