{
  "name": "@o3/guidance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync the brief corpus between repo markdown and the Sanity dataset (ADR 0027).",
  "scripts": {
    "brief:check": "sanity exec src/brief-check.ts --with-user-token --",
    "brief:export": "sanity exec src/brief-export.ts --with-user-token --",
    "brief:sync": "sanity exec src/brief-sync.ts --with-user-token --",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@o3/sanity": "workspace:*",
    "sanity": "6.8.0"
  },
  "devDependencies": {
    "@o3/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
