{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["packages/typescript-config/*.json"],
  "globalEnv": [
    "NEXT_PUBLIC_BRAND",
    "NEXT_PUBLIC_SANITY_PROJECT_ID",
    "NEXT_PUBLIC_SANITY_DATASET",
    "XO_SANITY_PROJECT_ID",
    "XO_SANITY_DATASET",
    "NEXT_PUBLIC_BASE_URL",
    "SANITY_API_READ_TOKEN",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_ENV",
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "SANITY_API_WRITE_TOKEN",
    "SANITY_REVALIDATE_SECRET",
    "WEB_PORT",
    "XO_WEB_PORT",
    "STORYBOOK_PORT",
    "XO_STORYBOOK_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.prettierrc*"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
