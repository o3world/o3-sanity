{
  "name": "o3-sanity",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "brief:check": "pnpm --filter @o3/guidance brief:check",
    "brief:export": "pnpm --filter @o3/guidance brief:export",
    "brief:sync": "pnpm --filter @o3/guidance brief:sync",
    "build": "turbo run build",
    "build:skill": "node tools/authoring-skill/build.mjs",
    "check": "turbo run lint typecheck --affected",
    "dataset": "./scripts/switch-dataset.sh",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix-mismatches",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter @o3/web",
    "down": "./scripts/down.sh",
    "env:pull": "pnpm exec vercel link --project o3-sanity-web --scope o3-world --yes && pnpm exec vercel env pull apps/web/.env.local --environment=development",
    "figma:sync": "pnpm --filter @o3/figma-sync sync",
    "format": "turbo run format",
    "frontier": "./scripts/frontier.sh",
    "guidance:check": "pnpm --filter @o3/guidance check",
    "guidance:sync": "pnpm --filter @o3/guidance sync",
    "knip": "knip --no-config-hints",
    "lint": "turbo run lint",
    "prepare": "[ -n \"$VERCEL\" ] || [ -n \"$CI\" ] || lefthook install",
    "schema:check": "pnpm --filter @o3/sanity schema:check",
    "schema:deploy": "pnpm --filter @o3/sanity schema:deploy",
    "skill:wire": "./tools/authoring-skill/wire-desktop.sh",
    "storybook": "turbo run storybook",
    "test": "vitest run",
    "test:fast": "vitest run --project unit --project render",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "typegen": "pnpm --filter @o3/sanity typegen",
    "verify": "turbo run lint typecheck build --affected",
    "vr": "pnpm --filter @o3/visual-regression run vr",
    "wt": "./scripts/worktree.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^16.2.4",
    "@o3/eslint-config": "workspace:*",
    "@o3/typescript-config": "workspace:*",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "knip": "^6.16.1",
    "lefthook": "^1.7.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "syncpack": "^15.3.1",
    "turbo": "^2.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.0",
    "vercel": "^59.1.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
