# os/editor
.DS_Store

# claude session state (.claude/skills/ IS committed)
.claude/worktrees/
.claude/scheduled_tasks.lock
.vercel
.env*

# design prototype (local-only; retired as a source of record by #33, kept for
# the seed docs' image assets until #48). No trailing slash: worktrees get it
# as a SYMLINK from scripts/worktree.sh, and `prototype/` would not match that.
prototype

# figma mcp image downloads
.figma/

# eval runs: a judged run belongs to one revision of one skill and is stale the
# moment either changes. Quote the JSON on the ticket instead — see
# tools/authoring-skill/evals/README.md.
tools/authoring-skill/evals/results/

# visual regression: the baseline checkout, both Storybook builds, every
# screenshot, and the report. All of it is derived from a commit and none of it
# is shared — see tools/visual-regression/README.md.
.vr/

# design-sync (/design-sync skill). Committed: .design-sync/config.json,
# NOTES.md, conventions.md, previews/, overrides/ — the inputs a re-sync
# replays. Everything below is derived: the reference storybook build, the
# staged converter, its output, and per-run verification state. Verified state
# travels in the uploaded project's _ds_sync.json, not in git.
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.design-sync/*.log
.design-sync/push-*.txt
.ds-sync/
ds-bundle/

# Sanity request-log exports and other unshared local data.
/private/

# Local production-browser motion evidence.
/test_output/
