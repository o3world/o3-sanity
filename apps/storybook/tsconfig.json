{
  "extends": "@o3/typescript-config/storybook.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@o3/story-kit": ["../../packages/story-kit/src/index.ts"],
      "@o3/story-kit/storybook-config": ["../../packages/story-kit/src/storybookConfig.ts"],
      "@o3/story-kit/storybook-preview": ["../../packages/story-kit/src/storybookPreview.ts"],
      "@o3/story-kit/*": ["../../packages/story-kit/src/*"],
      "@o3/ui": ["../../packages/ui/src/index.ts"],
      "@o3/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "../../packages/ui/src/**/*.stories.ts",
    "../../packages/ui/src/**/*.stories.tsx",
    "prototypes/**/*.ts",
    "prototypes/**/*.tsx"
  ],
  "exclude": ["node_modules", "storybook-static"]
}
