{
  "name": "@o3/sanity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint src/",
    "schema:check": "tsx src/schema-check.ts",
    "schema:deploy": "tsx src/schema-deploy.ts",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --workspace model --force --path=schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@o3/block-spec": "workspace:*",
    "@sanity/client": "^7.26.0",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "groq": "^6.8.0",
    "sanity": "6.8.0"
  },
  "devDependencies": {
    "@o3/typescript-config": "workspace:*",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "exports": {
    "./brand": "./src/brand.ts",
    "./client": "./src/client.ts",
    "./constants": "./src/constants.ts",
    "./image": "./src/image.ts",
    "./knobs": "./src/knobs/index.ts",
    "./queries": "./src/queries.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/registry": "./src/schemas/blocks/registry.ts",
    "./schemas/reserved-slugs": "./src/schemas/documents/reservedSlugs.ts",
    "./types": "./src/types.ts",
    "./types/generated": "./src/types/generated.ts"
  }
}
