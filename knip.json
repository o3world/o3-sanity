{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,route,not-found,error,loading}.tsx",
        "src/app/**/route.ts",
        "next.config.ts",
        "src/proxy.ts",
        "src/**/*.stories.tsx",
        "src/**/*.test.ts",
        "src/**/*.render.test.tsx",
        "src/test/index.ts",
        "src/test/setup.ts",
        "src/test/stubs/*.{ts,tsx}"
      ]
    },
    "apps/storybook": {
      "entry": [".storybook/{main,preview}.ts", "prototypes/**/*.stories.tsx"],
      "ignore": ["prototypes/*/**"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.stories.tsx", "sanity.cli.ts"]
    },
    "packages/editor-chrome": {
      "entry": [
        "src/studio/index.ts",
        "src/toolbar/index.ts",
        "src/canvas/index.ts",
        "src/draft-mode/index.ts",
        "src/**/*.test.ts"
      ]
    },
    "tools/migration": {
      "entry": ["src/{extract,convert,load}.ts", "sanity.cli.ts", "src/**/*.test.ts"]
    },
    "tools/guidance": {
      "entry": ["src/{sync,check}.ts", "sanity.cli.ts"]
    },
    "tools/figma-sync": {
      "entry": ["src/sync.ts", "src/**/*.test.ts"]
    }
  }
}
