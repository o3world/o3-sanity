# Machine-generated migration data. `convert` writes these with
# JSON.stringify(…, null, 2); prettier formats short arrays differently, so
# letting it reformat them on commit means every subsequent `pnpm convert`
# re-dirties the tree and the committed JSON stops being byte-reproducible.
# The pipeline owns this directory (ADR 0003) — prettier does not.
tools/migration/data/

# Machine-written figma-sync output, for the same reason (#78). `tracked-nodes.json`
# is hand-maintained and stays formatted; these three are overwritten by every run.
tools/figma-sync/data/baseline.json
tools/figma-sync/data/report.json
tools/figma-sync/data/report.md

# Captured prototypes (ADR 0010). Frozen third-party artifacts — reformatting
# one makes the committed file stop matching what was actually delivered, and
# the diff noise buries any real change to the set. Only the set directories;
# the story files and frame.tsx beside them are formatted normally.
apps/storybook/prototypes/*/

# The generated redirect table (#24). `pnpm --filter @o3/migration redirects`
# writes it from the committed WordPress export, and prettier wraps the long
# URLs — so letting it reformat means every regeneration re-dirties the tree
# and the committed file stops matching what the generator produces, which is
# the one thing `redirects.test.ts` checks.
apps/web/src/lib/redirects.generated.ts

# Next writes this file on every dev and build, with double quotes and a
# semicolon its writer hardcodes. Prettier's `semi: false, singleQuote: true`
# rewrites exactly that line, the pre-commit hook stages the rewrite, and the
# next `dev` writes it back — a dirty tree on every run. The file says it
# should not be edited; this is how we stop editing it.
apps/web/next-env.d.ts

# Build output
**/.next/
**/storybook-static/
**/dist/

# Baseline scenario scripts (#184). A re-run is judged by diffing its transcript
# against the 2026-08-16 baseline, which only holds if the script the two runs
# read is the same bytes. Prettier rewrites the emphasis markers in one of them.
# Only the scripts; the README beside them is formatted normally.
tools/authoring-skill/scenarios/scenario-*.md

# Corpus-reader fixtures. These test how the frontmatter parser treats
# byte-exact edge cases — a dash run, an unmatched quote — and prettier
# rewrites exactly those bytes into the well-formed shape the test needs
# them not to be.
tools/guidance/src/corpus/__fixtures__/
